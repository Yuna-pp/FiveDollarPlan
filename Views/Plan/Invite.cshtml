@model FiveDollarPlan.Models.PlanInviteViewModel

@{
    ViewData["Title"] = "Plan Invitation";
    var loginReturnUrl = ViewData["LoginReturnUrl"] as string;
}

<h1 class="h2 mb-3">Plan invitation</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["InfoMessage"] is string infoMessage)
{
    <div class="alert alert-info" role="status">@infoMessage</div>
}

<div class="card col-lg-8">
    <div class="card-body">
        <h2 class="h4">@Model.Name</h2>
        <dl class="row mb-4">
            <dt class="col-sm-4">Amount per participant</dt>
            <dd class="col-sm-8">NZ$@Model.Amount.ToString("0.00")</dd>
            <dt class="col-sm-4">Penalty mode</dt>
            <dd class="col-sm-8">@(Model.Mode == FiveDollarPlan.Models.PlanMode.Single ? "Single occurrence" : "Multiple occurrences")</dd>
            <dt class="col-sm-4">Plan period</dt>
            <dd class="col-sm-8">@Model.StartAtLocal.ToString("g") – @Model.EndAtLocal.ToString("g") (Pacific/Auckland)</dd>
            <dt class="col-sm-4">Invitation code</dt>
            <dd class="col-sm-8"><code>@Model.InviteCode</code></dd>
        </dl>

        @if (Model.IsMember)
        {
            <p class="text-success mb-0">You are already a member of this plan.</p>
        }
        else if (Model.IsAuthenticated)
        {
            <form asp-action="Join" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="InviteCode" value="@Model.InviteCode" />
                <button type="submit" class="btn btn-success">Join this plan</button>
            </form>
        }
        else
        {
            <p>Sign in to join. After signing in, return to this invitation page.</p>
            <a class="btn btn-success" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@loginReturnUrl">Sign in to join</a>
        }
    </div>
</div>

<p class="mt-3"><a asp-action="Index">Back to my plans</a></p>
