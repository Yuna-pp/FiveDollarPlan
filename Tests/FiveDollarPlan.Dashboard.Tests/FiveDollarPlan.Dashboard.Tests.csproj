<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Link Dashboard production sources; no database or shared-service dependency. -->
    <Compile Include="../../Services/Dashboard/DashboardFinancialCalculator.cs"
             Link="DashboardFinancialCalculator.cs" />
    <Compile Include="../../Controllers/DashboardController.cs" Link="DashboardController.cs" />
    <Compile Include="../../Models/Dashboard/DashboardPageViewModel.cs" Link="DashboardPageViewModel.cs" />
    <Compile Include="../../Services/Dashboard/DashboardPageBuilder.cs" Link="DashboardPageBuilder.cs" />
    <Compile Include="../../Services/Dashboard/DashboardPreviewData.cs" Link="DashboardPreviewData.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
